rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Roles stored in employees/{uid}.metadata.role
    // Falls back to 'admin' for admin@hr.local so the app works before seed
    function role() {
      let snap = get(/databases/$(database)/documents/employees/$(uid()));
      let r = snap != null && snap.data != null
        ? snap.data.get('metadata', {}).get('role', null)
        : null;
      return r != null ? r
        : (request.auth.token.email == 'admin@hr.local' ? 'admin' : 'employee');
    }

    function isAdmin() {
      return isAuthenticated() && (role() == 'admin' || request.auth.token.email == 'admin@hr.local');
    }

    // Admin bypass — full access to everything
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'admin@hr.local';
    }

    function isHR() {
      return isAdmin() || (isAuthenticated() && role() == 'hr');
    }

    function isManager() {
      return isHR() || (isAuthenticated() && role() == 'manager');
    }

    // ── employees ─────────────────────────────────────────────────────────────
    // Admin/HR: full CRUD
    // Manager: read all, cannot write salary fields
    // Employee: read own record only (public profile), no write

    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create, delete: if isHR();
      allow update: if isHR() || (
        // Manager can update non-sensitive fields of their team
        isManager() &&
        !('salary' in request.resource.data) &&
        !('authId' in request.resource.data)
      );

      // Job history subcollection — manager+ read, HR write
      match /job_history/{historyId} {
        allow read: if isManager();
        allow write: if isHR();
      }
    }

    // ── departments ───────────────────────────────────────────────────────────

    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isHR();
    }

    // ── attendance ────────────────────────────────────────────────────────────
    // Employee: read/write own records
    // Manager+: read all, no write (reports only)
    // HR: full access

    match /attendance/{recordId} {
      allow read: if isManager() || resource.data.employeeId == uid();
      allow create: if isAuthenticated() &&
        request.resource.data.employeeId == uid();
      allow update: if isHR() || resource.data.employeeId == uid();
      allow delete: if isHR();
    }

    // ── leaves ───────────────────────────────────────────────────────────────
    // Employee: create own, read own
    // Manager+: read all, approve/reject (update status field)
    // HR: full access

    match /leaves/{leaveId} {
      // Employee can read their own leaves — employeeId is the Firestore doc ID of the employee,
      // so we check both: direct uid match (if doc ID == auth uid) and via employees collection lookup
      allow read: if isManager() || (
        isAuthenticated() && (
          resource.data.employeeId == uid() ||
          exists(/databases/$(database)/documents/employees/$(resource.data.employeeId)) &&
          get(/databases/$(database)/documents/employees/$(resource.data.employeeId)).data.get('authId', '') == uid()
        )
      );
      allow create: if isAuthenticated() && (
        request.resource.data.employeeId == uid() ||
        (
          exists(/databases/$(database)/documents/employees/$(request.resource.data.employeeId)) &&
          get(/databases/$(database)/documents/employees/$(request.resource.data.employeeId)).data.get('authId', '') == uid()
        )
      );
      allow update: if isHR() || (
        isManager() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approverId'])
      );
      allow delete: if isHR();
    }

    match /leave_balances/{employeeId} {
      allow read: if isManager() || employeeId == uid() || (
        exists(/databases/$(database)/documents/employees/$(employeeId)) &&
        get(/databases/$(database)/documents/employees/$(employeeId)).data.get('authId', '') == uid()
      );
      allow create: if isManager() || employeeId == uid() || (
        exists(/databases/$(database)/documents/employees/$(employeeId)) &&
        get(/databases/$(database)/documents/employees/$(employeeId)).data.get('authId', '') == uid()
      );
      allow update: if isManager();
      allow delete: if isManager();
    }

    // ── recruitment ───────────────────────────────────────────────────────────

    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow write: if isHR();
    }

    match /candidates/{candidateId} {
      allow read: if isManager() || resource.data.email == request.auth.token.email;
      allow create: if isAuthenticated();
      allow update, delete: if isHR();
    }

    // ── performance ───────────────────────────────────────────────────────────
    // Employee: read own reviews, cannot see reviewer identity (handled app-side)
    // Manager+: read all submitted reviews
    // HR: full access

    match /reviews/{reviewId} {
      allow read: if isHR() || (
        isManager() && resource.data.status == 'submitted'
      ) || (
        resource.data.status == 'submitted' &&
        resource.data.revieweeEmail == request.auth.token.email
      );
      allow create: if isManager();
      allow update: if isHR() || resource.data.reviewerId == uid();
      allow delete: if isHR();
    }

    // ── trainings & compliance ────────────────────────────────────────────────

    match /trainings/{trainingId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    match /employee_trainings/{recordId} {
      allow read: if isManager() || resource.data.employeeId == uid();
      allow create: if isAuthenticated() && request.resource.data.employeeId == uid();
      allow update, delete: if isManager();
    }

    // ── benefits ─────────────────────────────────────────────────────────────

    match /benefits/{benefitId} {
      allow read: if isAuthenticated();
      allow write: if isHR();
    }

    match /employee_benefits/{employeeId} {
      allow read: if isManager() || employeeId == uid();
      // Employee can enroll/unenroll themselves; HR can write anything
      allow write: if isHR() || employeeId == uid();
    }

    // ── documents ─────────────────────────────────────────────────────────────

    match /documents/{docId} {
      allow read: if isHR() || resource.data.uploadedBy == uid() || (
        resource.data.employeeId != null && resource.data.employeeId == uid()
      );
      allow create: if isAuthenticated();
      allow update: if isHR() || resource.data.uploadedBy == uid();
      allow delete: if isHR() || resource.data.uploadedBy == uid();
    }

    // ── user_settings ─────────────────────────────────────────────────────────

    match /user_settings/{userId} {
      allow read, write: if isAuthenticated() && userId == uid();
    }

    // ── system_stats (dashboard aggregates) ──────────────────────────────────

    match /system_stats/{docId} {
      allow read: if isManager();
      // Only Cloud Functions should write — deny all client writes
      allow write: if false;
    }

    // ── positions ────────────────────────────────────────────────────────────

    match /positions/{positionId} {
      allow read: if isAuthenticated();
      allow write: if isHR();
    }

    // ── tasks ─────────────────────────────────────────────────────────────────

    match /tasks/{taskId} {
      allow read: if isManager() || resource.data.assigneeEmail == request.auth.token.email;
      allow create: if isManager();
      allow update: if isManager() || (
        isAuthenticated() &&
        resource.data.assigneeEmail == request.auth.token.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isManager();
    }

    // ── audit_log ─────────────────────────────────────────────────────────────

    match /audit_log/{logId} {
      allow read: if isHR();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ── chat ─────────────────────────────────────────────────────────────────

    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && uid() in resource.data.participants;
      allow create: if isAuthenticated() && uid() in request.resource.data.participants;
      allow update: if isAuthenticated() && uid() in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          uid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated() &&
          uid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.senderId == uid();
      }
    }
  }
}

# Dane logowania do testów E2E
# Skopiuj ten plik do .env.test.local i uzupełnij wartości

# Konto admina (domyślnie admin@hr.local / admin123)
TEST_ADMIN_EMAIL=admin@hr.local
TEST_ADMIN_PASSWORD=admin123

# Konto pracownika (opcjonalne — jeśli puste, testy employee używają sesji admina)
TEST_EMPLOYEE_EMAIL=
TEST_EMPLOYEE_PASSWORD=
